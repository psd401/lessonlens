# Ignore everything except backend and shared modules
LessonLens/
docs/
scripts/
.git/
.github/
*.md
*.png
*.jpg
LICENSE
.gitignore

# Local drafts, worktrees, and review material (never part of the backend image)
.claude/
explainer-video/
press-kit-draft/
review/

# Installed by the image build itself (Dockerfile runs bun install)
node_modules/
dist/

# Local secrets never belong in a Cloud Build upload
.env
.env.*
