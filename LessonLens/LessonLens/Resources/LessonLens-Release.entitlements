<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Release builds run outside the app sandbox, like every release so far
         (v1.1.1 shipped with no entitlements), so teachers' existing data in
         ~/Library/Application Support stays visible. Under the hardened
         runtime the microphone still needs this entitlement. Adopting the
         sandbox needs a container-migration plan first; see RELEASING.md. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
